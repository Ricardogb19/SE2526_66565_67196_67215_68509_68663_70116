@startuml StatePattern
' clean rendering
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

package "core/src/mindustry/game" {
  interface State {
    +enter()
    +exit()
    +update(dt: float)
    +draw()
    +handleInput(event)
  }

  class GameState {
    - current: State
    + setState(s: State): void
    + update(dt: float): void
    + draw(): void
    + handleInput(event): void
  }

  class PlayState {
    + enter()
    + exit()
    + update(dt: float)
    + draw()
    + handleInput(event)
  }

  class MenuState {
    + enter()
    + exit()
    + update(dt: float)
    + draw()
    + handleInput(event)
  }

  class EditorState {
    + enter()
    + exit()
    + update(dt: float)
    + draw()
    + handleInput(event)
  }

  class LoadingState {
    + enter()
    + exit()
    + update(dt: float)
    + draw()
    + handleInput(event)
  }
}

' relationships: GameState delegates to current State
GameState --> State : "holds & delegates to"
PlayState ..|> State
MenuState ..|> State
EditorState ..|> State
LoadingState ..|> State

' example of state transition sequence (behavior)
note right of GameState
  Typical setState sequence:
  1) if(current != null) current.exit()
  2) current = newState
  3) current.enter()
end note

' file location notes
note left of State
  State interface and implementations:
  core/src/mindustry/game/states/   (PlayState, MenuState, EditorState, ...)
end note

note left of GameState
  Context manager:
  core/src/mindustry/game/GameState.java
end note
@enduml